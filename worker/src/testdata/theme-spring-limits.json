{
  "description": "Springs a theme may set, and what each is clamped to. worker/src/themeIdeas.test.ts and leanring-buddyTests/ThemeMotionTests.swift both read this file, so the Worker's checkThemeIdeas and the app's ClickyTheme.parse cannot clamp differently.",
  "limits": {
    "pop": { "response": [0.2, 0.45], "dampingFraction": [0.55, 1] },
    "glide": { "response": [0.3, 0.55], "dampingFraction": [0.75, 1] },
    "point": { "response": [0.3, 0.6] }
  },
  "cases": [
    {
      "name": "springs inside every limit stay as they are",
      "input": { "pop": { "response": 0.3, "dampingFraction": 0.6 }, "glide": { "response": 0.4, "dampingFraction": 0.8 }, "point": { "response": 0.4 } },
      "expected": { "pop": { "response": 0.3, "dampingFraction": 0.6 }, "glide": { "response": 0.4, "dampingFraction": 0.8 }, "point": { "response": 0.4 } }
    },
    {
      "name": "the limits themselves are allowed",
      "input": { "pop": { "response": 0.2, "dampingFraction": 0.55 }, "glide": { "response": 0.55, "dampingFraction": 1 }, "point": { "response": 0.6 } },
      "expected": { "pop": { "response": 0.2, "dampingFraction": 0.55 }, "glide": { "response": 0.55, "dampingFraction": 1 }, "point": { "response": 0.6 } }
    },
    {
      "name": "a spring too slow and too bouncy is moved to the slowest and bounciest allowed",
      "input": { "pop": { "response": 2, "dampingFraction": 0.1 }, "glide": { "response": 3, "dampingFraction": 0.2 }, "point": { "response": 5 } },
      "expected": { "pop": { "response": 0.45, "dampingFraction": 0.55 }, "glide": { "response": 0.55, "dampingFraction": 0.75 }, "point": { "response": 0.6 } }
    },
    {
      "name": "a spring too quick and over-damped is moved to the quickest and most damped allowed",
      "input": { "pop": { "response": 0.01, "dampingFraction": 4 }, "glide": { "response": 0, "dampingFraction": 9 }, "point": { "response": -1 } },
      "expected": { "pop": { "response": 0.2, "dampingFraction": 1 }, "glide": { "response": 0.3, "dampingFraction": 1 }, "point": { "response": 0.3 } }
    }
  ]
}
